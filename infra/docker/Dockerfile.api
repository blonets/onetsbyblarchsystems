# syntax=docker/dockerfile:1
# @mtk/api — NestJS backend
FROM node:24-slim AS base
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
# openssl: Prisma engine detection needs it (without it Prisma defaults to
# openssl-1.1.x engines that don't exist on Debian bookworm).
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app

FROM base AS builder
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm install --frozen-lockfile
# Prisma engines download here (build host has network; the sandbox/CI does not).
# The API refuses to boot without a generated client (see src/db/prisma.service.ts).
RUN pnpm --filter @mtk/api exec prisma generate
RUN pnpm --filter @mtk/api... build
RUN pnpm --filter @mtk/api --prod deploy /prod/api \
  && PRISMA_SRC=$(echo /app/node_modules/.pnpm/@prisma+client*/node_modules) \
  && PRISMA_DST=$(echo /prod/api/node_modules/.pnpm/@prisma+client*/node_modules) \
  && cp -r "$PRISMA_SRC/.prisma" "$PRISMA_DST/" \
  && cp -r "$PRISMA_SRC/@prisma/client" "$PRISMA_DST/@prisma/"

FROM node:24-slim AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /prod/api ./
# Prisma CLI (pinned to the version in apps/api/package.json) + schema/migrations,
# so the entrypoint can run `prisma migrate deploy` at container start.
COPY --from=builder /app/apps/api/prisma ./prisma
# Prisma CLI installed in an ISOLATED dir: npm must never read the app's
# package.json (it uses the pnpm-only `workspace:` protocol and npm aborts).
RUN mkdir -p /opt/prisma-cli \
  && cd /opt/prisma-cli \
  && npm init -y >/dev/null 2>&1 \
  && npm install --no-save --no-audit --no-fund prisma@6.16.0
# curl for the HEALTHCHECK; openssl for the Prisma engines at runtime.
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl openssl \
  && rm -rf /var/lib/apt/lists/*
COPY infra/docker/api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
RUN chmod +x /usr/local/bin/api-entrypoint.sh
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS "http://localhost:${API_PORT:-3001}/health" || exit 1
ENTRYPOINT ["/usr/local/bin/api-entrypoint.sh"]
CMD ["node", "dist/main.js"]
