# syntax=docker/dockerfile:1
# @mtk/api — NestJS backend
FROM node:24-slim AS base
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app

FROM base AS builder
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm install --frozen-lockfile
# Prisma engines download here (build host has network; the sandbox/CI does not).
# The API refuses to boot without a generated client (see src/db/prisma.service.ts).
RUN pnpm --filter @mtk/api exec prisma generate
RUN pnpm --filter @mtk/api build
RUN pnpm --filter @mtk/api --prod deploy /prod/api

FROM node:24-slim AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /prod/api ./
EXPOSE 3001
CMD ["node", "dist/main.js"]
