# =============================================================================
# MikroTik Fleet Platform — Environment Variables (comprehensive reference)
# =============================================================================
# Copy to `.env` for local dev (NEVER commit `.env`).
# For Dokploy: paste these into Project > Environment > Compose > Environment.
#
# Conventions:
#   - REQUIRED variables have no default in compose.yml — the stack will fail
#     fast if they are missing. Set them all before deploying.
#   - OPTIONAL variables show their default after `:-` in compose.yml.
#   - Values marked CHANGE_ME must be replaced with real secrets.
#   - Generate strong secrets, e.g.:  openssl rand -base64 32 | tr -dc 'a-zA-Z0-9'
# =============================================================================

# ---------------------------------------------------------------------------
# Database — PostgreSQL with TimescaleDB (service: postgres)
# ---------------------------------------------------------------------------
# REQUIRED. Database superuser credentials; also used by the postgres
# healthcheck. The API connects via DATABASE_URL below.
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_STRONG_32CHAR
POSTGRES_DB=mtk_fleet

# REQUIRED. Full connection string the API and worker use.
# Inside Dokploy/compose networking the host is the service name `postgres`.
DATABASE_URL=postgresql://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@postgres:5432/mtk_fleet

# ---------------------------------------------------------------------------
# Redis — BullMQ queues and cache (service: redis)
# ---------------------------------------------------------------------------
# REQUIRED. Inside compose networking the host is the service name `redis`.
# If you set a Redis password, use: redis://:PASSWORD@redis:6379
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# API — NestJS backend (service: api)
# ---------------------------------------------------------------------------
# OPTIONAL (default 3001). Port the API listens on inside the container.
API_PORT=3001

# REQUIRED. Signs JWT access tokens. Must be long and random; rotate if leaked.
JWT_SECRET=CHANGE_ME_STRONG_64CHAR

# OPTIONAL (default 3600). JWT lifetime in seconds.
JWT_EXPIRES_IN=3600

# OPTIONAL. Allowed browser origin(s) for CORS, comma-separated.
# Production: your dashboard URL, e.g. https://admin.example.com
CORS_ORIGIN=

# OPTIONAL. Public base URL of the API, used for callbacks/links in emails.
# Production: e.g. https://api.example.com
PUBLIC_API_URL=

# OPTIONAL. Public base URL of the dashboard, used for links in emails.
# Production: e.g. https://admin.example.com
PUBLIC_WEB_URL=

# ---------------------------------------------------------------------------
# MikroTik hub — SSTP VPN concentrator + RouterOS API target
# ---------------------------------------------------------------------------
# REQUIRED. Hub DNS name the site routers dial for SSTP. Never hardcode the
# hub's IP — DNS keeps the fleet portable if the hub ever moves.
SSTP_HUB_HOST=CHANGE_ME_HUB_DNS_NAME

# OPTIONAL (default 8728). RouterOS API port on the hub.
SSTP_HUB_API_PORT=8728

# REQUIRED. RouterOS user the platform uses to manage the hub.
# Use a dedicated least-privilege user, not `admin`.
SSTP_HUB_API_USER=CHANGE_ME_HUB_API_USER

# REQUIRED. Password for the hub API user.
SSTP_HUB_API_PASSWORD=CHANGE_ME_HUB_API_PASSWORD

# ---------------------------------------------------------------------------
# Tunnel network — addressing for the hub-and-spoke SSTP topology
# ---------------------------------------------------------------------------
# OPTIONAL (default 10.200.0.0/16). Supernet carved into per-router /30s.
TUNNEL_SUPERNET=10.200.0.0/16

# OPTIONAL (default 10.200.0.1). Hub's own address on the tunnel network.
TUNNEL_HUB_IP=10.200.0.1

# ---------------------------------------------------------------------------
# Web — Next.js dashboard (service: web)
# ---------------------------------------------------------------------------
# REQUIRED (build-time). Public URL where browsers reach the API.
# Production: e.g. https://api.example.com
# NOTE: Next.js bakes NEXT_PUBLIC_* into the client bundle at BUILD time —
# changing it requires rebuilding the web image.
NEXT_PUBLIC_API_URL=CHANGE_ME_PUBLIC_API_URL

# ---------------------------------------------------------------------------
# Worker — BullMQ background jobs (service: worker)
# ---------------------------------------------------------------------------
# OPTIONAL (default 0). Shard index for this worker replica.
WORKER_SHARD_INDEX=0

# OPTIONAL (default 1). Total number of worker shards; each replica gets a
# unique WORKER_SHARD_INDEX in [0, WORKER_SHARD_COUNT).
WORKER_SHARD_COUNT=1

# OPTIONAL (default 60000). Router polling interval in milliseconds.
POLL_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# SMTP — outbound email for alerts and notifications (used by: api)
# ---------------------------------------------------------------------------
# OPTIONAL. Leave empty to disable email sending (alerts stay in-app only).
SMTP_HOST=
# OPTIONAL (default 587). 465 = implicit TLS, 587 = STARTTLS.
SMTP_PORT=587
# OPTIONAL (default false). true for port 465 (implicit TLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
# OPTIONAL. Default From: address, e.g. "Fleet Platform <noreply@example.com>".
SMTP_FROM=

# ---------------------------------------------------------------------------
# Domains — reference only; actual domain binding happens in the Dokploy UI
# (Application > Domains). Keep these in sync with what you configure there.
# ---------------------------------------------------------------------------
# Dashboard domain, e.g. admin.example.com
DOMAIN_WEB=CHANGE_ME_WEB_DOMAIN
# Public API domain, e.g. api.example.com
DOMAIN_API=CHANGE_ME_API_DOMAIN
