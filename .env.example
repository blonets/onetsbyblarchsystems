# =====================================================================
# MikroTik Fleet Platform — environment template (PLACEHOLDERS ONLY)
# Copy to .env for local dev. NEVER commit a real .env with secrets.
# =====================================================================

# --- Hub CHR (SSTP server). Reach via DNS, never hardcode an IP. ---
SSTP_HUB_HOST=hub.example.com
SSTP_HUB_API_PORT=8728
SSTP_HUB_API_USER=panel-api
SSTP_HUB_API_PASSWORD=CHANGEME-strong-password

# --- Hub service ports (operator reference) ------------------------------
# The hub CHR runs non-default service ports:
#   SSH 8922, Telnet 8923, FTP 8921, WWW 8980
# Reference only — the platform always reads ports from the Router record
# (apiPort, apiSslPort, winboxPort, sshPort, telnetPort, ftpPort, wwwPort);
# no code hard-codes them.

# --- Tunnel supernet: per-router static tunnel IP from this range ----
TUNNEL_SUPERNET=10.200.0.0/16
TUNNEL_HUB_IP=10.200.0.1

# --- PostgreSQL + TimescaleDB ---------------------------------------
POSTGRES_USER=mtk
POSTGRES_PASSWORD=CHANGEME-db-password
POSTGRES_DB=mtk_fleet
DATABASE_URL=postgresql://mtk:CHANGEME-db-password@postgres:5432/mtk_fleet

# --- Redis (BullMQ) --------------------------------------------------
REDIS_URL=redis://redis:6379

# --- API -------------------------------------------------------------
API_PORT=3001
JWT_SECRET=CHANGEME-generate-32-random-bytes
JWT_EXPIRES_IN=3600

# --- Web -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Worker sharding -------------------------------------------------
WORKER_SHARD_INDEX=0
WORKER_SHARD_COUNT=1
POLL_INTERVAL_MS=60000
