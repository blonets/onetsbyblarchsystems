// Prisma schema — MikroTik fleet platform.
//
// TimescaleDB: time-series tables (RouterMetric, DowntimeLedger) become
// hypertables via a SQL migration, NOT via Prisma:
//   SELECT create_hypertable('RouterMetric', 'time');
// Run `SELECT create_extension('timescaledb')` once per database (see
// infra/dokploy/compose.yml — the timescale/timescaledb image ships it).
//
// TODO: add the `prisma` CLI as a devDependency and run `prisma generate`
// (needs network access to binaries.prisma.sh for the engine download) once
// DATABASE_URL is set, then replace the in-memory stores in routers.service.ts
// with PrismaClient.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String?
  roles        Role[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditEvents  AuditLog[]
}

model Role {
  id    String @id @default(uuid())
  name  String @unique // admin | operator | viewer
  users User[]
}

model Site {
  id           String   @id @default(uuid())
  name         String
  address      String?
  city         String?
  country      String?
  latitude     Float?
  longitude    Float?
  contactName  String?
  contactPhone String?
  notes        String?
  routers      Router[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Router {
  id              String   @id @default(uuid()) // stamped as panel-uuid:<id> in /system identity comment
  siteId          String
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  identity        String
  identityComment String?
  model           String?
  boardName       String?
  rosVersion      String?
  architecture    String?
  tunnelIp        String?  @unique // static 10.200.0.0/16 address (ppp secret remote-address)
  sstpUsername    String?  @unique // per-router UNIQUE SSTP username
  sstpPasswordRef String?  // vault reference — NEVER a plaintext password
  // Service ports are first-class: the hub CHR runs SSH 8922 / Telnet 8923 /
  // FTP 8921 / WWW 8980; site routers may differ too. ros-api always connects
  // to these values — never to hard-coded ports. Defaults are RouterOS factory defaults.
  apiPort         Int      @default(8728)
  apiSslPort      Int      @default(8729)
  winboxPort      Int      @default(8291)
  sshPort         Int      @default(22)
  telnetPort      Int      @default(23)
  ftpPort         Int      @default(21)
  wwwPort         Int      @default(80)
  status          String   @default("unknown") // RouterStatus: online|offline|provisioning|error|unknown
  lastSeenAt      DateTime?
  isHub           Boolean  @default(false)
  // Cascade: a downstream MikroTik behind this router registers as a Router too.
  parentRouterId  String?
  parentRouter    Router?  @relation("RouterCascade", fields: [parentRouterId], references: [id])
  children        Router[] @relation("RouterCascade")
  hotspotServers  HotspotServer[]
  hotspotProfiles HotspotProfile[]
  hotspotUsers    HotspotUser[]
  firewallRules   FirewallRule[]
  queues          Queue[]
  backups         Backup[]
  downstreamDevices DownstreamDevice[]
  metrics         RouterMetric[]
  downtime        DowntimeLedger[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([siteId])
  @@index([status])
}

model HotspotServer {
  id        String  @id @default(uuid())
  routerId  String
  router    Router  @relation(fields: [routerId], references: [id], onDelete: Cascade)
  name      String
  interface String
  addressPool String?
  profile   String?
  disabled  Boolean @default(false)

  @@index([routerId])
}

model HotspotProfile {
  id               String  @id @default(uuid())
  routerId         String
  router           Router  @relation(fields: [routerId], references: [id], onDelete: Cascade)
  name             String
  rateLimit        String?
  sessionTimeout   String?
  idleTimeout      String?
  sharedUsers      Int?
  transparentProxy Boolean @default(false)
  comment          String?

  @@index([routerId])
}

model HotspotUser {
  id         String  @id @default(uuid())
  routerId   String
  router     Router  @relation(fields: [routerId], references: [id], onDelete: Cascade)
  server     String
  name       String
  profile    String  @default("default")
  disabled   Boolean @default(false)
  limitUptime String?
  comment    String?

  @@index([routerId])
  @@index([routerId, name])
}

model FirewallRule {
  id          String  @id @default(uuid())
  routerId    String
  router      Router  @relation(fields: [routerId], references: [id], onDelete: Cascade)
  chain       String
  action      String
  protocol    String?
  srcAddress  String?
  dstAddress  String?
  srcPort     String?
  dstPort     String?
  inInterface String?
  outInterface String?
  toAddresses String?
  toPorts     String?
  comment     String?
  disabled    Boolean @default(false)
  source      String  @default("device") // platform | device (panel-proxy:* => platform)

  @@index([routerId])
}

model Queue {
  id        String  @id @default(uuid())
  routerId  String
  router    Router  @relation(fields: [routerId], references: [id], onDelete: Cascade)
  name      String
  target    String
  maxLimit  String?
  limitAt   String?
  disabled  Boolean @default(false)
  comment   String?

  @@index([routerId])
}

model Backup {
  id          String   @id @default(uuid())
  routerId    String
  router      Router   @relation(fields: [routerId], references: [id], onDelete: Cascade)
  fileName    String
  kind        String   // binary | export
  sizeBytes   Int?
  storagePath String?
  createdAt   DateTime @default(now())

  @@index([routerId])
}

/// A downstream device behind a site router, exposed via a platform-managed
/// dst-nat rule (comment `panel-proxy:<deviceId>`).
model DownstreamDevice {
  id             String   @id // <deviceId> used in the panel-proxy:<deviceId> nat comment
  routerId       String
  router         Router   @relation(fields: [routerId], references: [id], onDelete: Cascade)
  kind           String   // mikrotik | camera | printer | other
  label          String?
  ipAddress      String
  servicePort    Int
  proxyPort      Int?     // WAN-side port on the site router, assigned by the platform
  natRuleId      String?  // RouterOS .id of the managing dst-nat rule
  managedRouterId String? // Router.id when kind == mikrotik and cascaded
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([routerId])
}

model ProvisioningToken {
  token     String   @id
  routerId  String
  expiresAt DateTime
  usedAt    DateTime?

  @@index([routerId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorType  String   @default("system") // user | system
  action     String   // e.g. router.provision, firewall.rule.create
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Time-series: polled metrics per router. Made a TimescaleDB hypertable by migration.
model RouterMetric {
  time     DateTime
  routerId String
  router   Router   @relation(fields: [routerId], references: [id], onDelete: Cascade)
  cpuLoad  Float?
  freeMemoryBytes  BigInt?
  uptimeSeconds    BigInt?

  @@id([time, routerId])
}

/// Time-series: downtime windows. Made a TimescaleDB hypertable by migration.
model DowntimeLedger {
  time          DateTime
  routerId      String
  router        Router   @relation(fields: [routerId], references: [id], onDelete: Cascade)
  reconnectedAt DateTime?
  durationMs    BigInt?
  reason        String?

  @@id([time, routerId])
}
