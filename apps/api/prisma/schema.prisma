// Prisma schema — MikroTik fleet platform.
//
// Conventions: `id` = cuid() string PK; all timestamps UTC; soft-delete via
// `deletedAt` where noted.
//
// CREDENTIAL RULE (NON-NEGOTIABLE): business tables store only REFERENCES
// (`sstpPasswordRef`, `apiPasswordRef` → vault ref) — never plaintext
// secrets. Secret values themselves persist only as AES-256-GCM ciphertext
// in `vault_entries` (see `src/vault/` — PostgresVault; the master key
// lives in the VAULT_MASTER_KEY env var, never in the DB).
//
// TimescaleDB: the metric_* tables are created as hypertables by migration
// `0002_timescale` (raw SQL — Prisma doesn't manage hypertables natively).
// Run `CREATE EXTENSION IF NOT EXISTS timescaledb` once per database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String // bcrypt (cost 12)
  role         Role      @relation(fields: [roleId], references: [id])
  roleId       String
  sites        SiteUser[]
  auditLogs    AuditLog[]
  tokensIssued OnboardingToken[]
  refreshTokens RefreshToken[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  disabledAt   DateTime?

  @@index([roleId])
}

/// Role names are fixed by the architecture contract:
/// admin | operator | technician | viewer.
/// Permissions are enforced code-level by the RBAC guard (rank-based):
/// viewer(1) < technician(2) < operator(3) < admin(4).
/// Technician: onboard + view. Operator: + hotspot/firewall/queues.
/// Admin: + users, secret rotation, restore.
model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  users       User[]
}

model SiteUser {
  userId String
  siteId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([userId, siteId])
}

/// Hashed refresh tokens. Rotation: on refresh the presented token is revoked
/// and replaced; reuse of a revoked token revokes the whole chain (theft detection).
model RefreshToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique // sha256 of the opaque token
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Fleet
// ---------------------------------------------------------------------------

model Site {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  address   String?
  city      String?
  country   String     @default("EG")
  lat       Float?
  lng       Float?
  notes     String?
  routers   Router[]
  users     SiteUser[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  @@index([slug])
}

model Router {
  id   String @id @default(cuid())
  uuid String @unique // stamped into the router; identity anchor (panel-uuid:<uuid>)

  site   Site?   @relation(fields: [siteId], references: [id])
  siteId String?

  // --- tunnel identity ---
  tunnelIp        String  @unique // 10.200.x.y, static via /ppp secret remote-address
  sstpUsername    String  @unique // per-router unique SSTP username
  sstpPasswordRef String // Vault/KMS reference ONLY — never plaintext
  apiUsername     String  @default("panel-api")
  apiPasswordRef  String // Vault/KMS reference ONLY — never plaintext

  // --- service ports (per-router configurable; field routers use custom ports,
  //     e.g. hub CHR: ssh 8922 / telnet 8923 / ftp 8921 / www 8980) ---
  apiPort    Int @default(8728)
  apiSslPort Int @default(8729)
  winboxPort Int @default(8291)
  sshPort    Int @default(22)
  telnetPort Int @default(23)
  ftpPort    Int @default(21)
  wwwPort    Int @default(80)

  // --- state ---
  status          RouterStatus @default(pending) // pending|online|offline|suspect|decommissioned
  lastSeen        DateTime?
  routerOsVersion String? // e.g. "7.15.2"
  boardName       String? // e.g. "hAP ac^2"
  serialNumber    String?
  identityName    String? // /system identity name (site slug)
  tags            String[] @default([]) // free-form grouping labels, e.g. ["cairo","vip"]
  flapCount       Int     @default(0) // tunnel flaps in last hour (worker-maintained)
  pollerShard     Int     @default(0) // hash(uuid) % shards; assigned by worker

  downtimes      Downtime[]
  hotspotServers HotspotServer[]
  hotspotProfiles HotspotProfile[] // server-profiles
  hotspotUserProfiles HotspotUserProfile[] // user-profiles (plans)
  hotspotBatches HotspotBatch[] // voucher/credential generation batches
  hotspotActiveSessions HotspotActiveSession[] // worker-reported online sessions
  hotspotUsers   HotspotUser[]
  hotspotWalledGardens HotspotWalledGarden[]
  firewallRules  FirewallRule[]
  firewallJournals FirewallJournal[] // rollback journal for firewall changes
  queues         Queue[]
  backups        Backup[]
  backupSchedules BackupSchedule[]
  downstream     DownstreamDevice[]
  auditLogs      AuditLog[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  decommissionedAt DateTime?

  @@index([status])
  @@index([siteId])
  @@index([pollerShard])
  @@index([lastSeen])
}

enum RouterStatus {
  pending
  online
  offline
  suspect
  decommissioned
}

/// Downtime ledger: one row per offline episode. Opened on missed heartbeats,
/// closed on reconnect (endedAt + durationS).
model Downtime {
  id        String    @id @default(cuid())
  router    Router    @relation(fields: [routerId], references: [id], onDelete: Cascade)
  routerId  String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  durationS Int? // set on close
  cause     String? // heartbeat-missed | tunnel-flap | maintenance

  @@index([routerId, startedAt])
}

// ---------------------------------------------------------------------------
// Hotspot v1
// ---------------------------------------------------------------------------

model HotspotServer {
  id         String  @id @default(cuid())
  router     Router  @relation(fields: [routerId], references: [id], onDelete: Cascade)
  routerId   String
  name       String // RouterOS-side name
  interface  String
  addressPool String?
  profile    String // server-profile name
  disabled   Boolean @default(false)
  mikrotikId String? // *ID from /ip/hotspot/print (for reconciliation)

  @@unique([routerId, name])
  @@index([routerId])
}

/// Server-profile (/ip/hotspot/profile).
model HotspotProfile {
  id             String  @id @default(cuid())
  router         Router  @relation(fields: [routerId], references: [id], onDelete: Cascade)
  routerId       String
  name           String
  hotspotAddress String?
  dnsName        String?
  loginBy        String? // http-pap,http-chap,cookie,...
  rateLimit      String?
  mikrotikId     String?

  @@unique([routerId, name])
  @@index([routerId])
}

/// User-profile = plan (/ip/hotspot/user/profile).
model HotspotUserProfile {
  id               String  @id @default(cuid())
  router           Router  @relation(fields: [routerId], references: [id], onDelete: Cascade)
  routerId         String
  name             String
  rateLimit        String? // e.g. "5M/10M"
  sharedUsers      Int?
  sessionTimeout   String?
  idleTimeout      String?
  keepaliveTimeout String?
  quotaBytes       BigInt? // enforced by quota-enforcer (null = unlimited)
  quotaSeconds     Int?
  macAddress       String? // pinned MAC (platform-side; RouterOS has no native user↔MAC pin)
  limitUptime      String? // total session cap, e.g. "12:00:00" → device `limit-uptime`
  validitySeconds  Int?    // validity window (s) starting at FIRST login — distinct from limitUptime
  price            Float?  // voucher face value (revenue tile); null = unset → 0
  expiryMode       String  @default("none") // remove | notify | remove+notify | none
  mikrotikId       String?
  users            HotspotUser[]

  @@unique([routerId, name])
  @@index([routerId])
}

/// One voucher/credential generation batch (one BullMQ job, idempotent by opId).
model HotspotBatch {
  id         String   @id @default(cuid())
  router     Router   @relation(fields: [routerId], references: [id], onDelete: Cascade)
  routerId   String
  mode       String   // up | vc
  prefix     String   @default("")
  count      Int
  codeLength Int
  profileId  String?
  note       String?
  opId       String   @unique // idempotency key for the whole batch
  users      HotspotUser[]
  createdAt  DateTime @default(now())

  @@index([routerId])
}

/// Worker-reported active hotspot sessions (/ip/hotspot/active). Replaced wholesale
/// on every poller ingest — a read model for session search, not history.
model HotspotActiveSession {
  id         String   @id @default(cuid())
  router     Router   @relation(fields: [routerId], references: [id], onDelete: Cascade)
  routerId   String
  username   String
  address    String?  // session IP
  macAddress String?
  uptime     String?
  server     String?
  reportedAt DateTime @default(now())

  @@index([routerId])
  @@index([username])
}

model HotspotUser {
  id          String             @id @default(cuid())
  router      Router             @relation(fields: [routerId], references: [id], onDelete: Cascade)
  routerId    String
  name        String
  passwordRef String? // Vault/KMS reference; null for MAC-cookie users
  profile     HotspotUserProfile? @relation(fields: [profileId], references: [id])
  profileId   String?
  mode        String?  // up | vc — generation mode (null = single manual create)
  batch       HotspotBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  batchId     String?
  /// Clock model: validityFromFirstLogin=false → expiresAt is absolute;
  /// true → validitySeconds count from firstLoginAt. Explicitly distinct from
  /// limitUptime (total session cap pushed to the device).
  validityFromFirstLogin Boolean @default(false)
  validitySeconds Int?     // validity window (s) from first login
  limitUptime     String?  // total session cap, e.g. "12:00:00" → device `limit-uptime`
  firstLoginAt    DateTime? // first auth seen by the worker (starts the validity clock)
  macAddress      String?  // pinned MAC (see HotspotUserProfile.macAddress)
  expiryMode      String   @default("none") // remove | notify | remove+notify | none
  disabled    Boolean            @default(false)
  uptimeUsedS BigInt             @default(0) // reconciled from /ip/hotspot/user
  bytesIn     BigInt             @default(0)
  bytesOut    BigInt             @default(0)
  expiresAt   DateTime? // absolute expiry (legacy); user expires when EITHER clock passes
  comment     String? // batch encoding: vc-<batchId>-<YYYYMMDD>-<note>
  mikrotikId  String?
  createdAt   DateTime           @default(now())

  @@unique([routerId, name])
  @@index([routerId, disabled])
  @@index([batchId])
}

// ---------------------------------------------------------------------------
// Firewall
// ---------------------------------------------------------------------------

model FirewallRule {
  id        String  @id @default(cuid())
  router    Router  @relation(fields: [routerId], references: [id], onDelete: Cascade)
  routerId  String
  table     String // filter | nat | mangle
  chain     String // input | forward | dstnat | srcnat | prerouting ...
  action    String // accept | drop | dst-nat | masquerade ...
  order     Int    // platform-side ordering; reconciled via place-before
  // match fields (nullable; only set ones are sent)
  protocol     String?
  srcAddress   String?
  dstAddress   String?
  srcPort      String?
  dstPort      String?
  inInterface  String?
  outInterface String?
  toAddresses  String?
  toPorts      String?
  comment      String? // panel-managed rules use comment prefixes, e.g. panel-proxy:
  disabled     Boolean @default(false)
  managed      Boolean @default(true) // false = discovered, read-only in UI
  /// Soft-delete marker set by firewall rollback: the rule is disabled
  /// on-device but the mirror row is kept (with the journal) — rollback never
  /// hard-deletes a journaled rule.
  revoked      Boolean @default(false)
  mikrotikId   String?

  @@index([routerId, table, chain, order])
}

/// Rollback journal for firewall changes. Written BEFORE any firewall
/// mutation is applied; `POST .../firewall/rollback/:journalId` restores the
/// before-snapshot. Journaled rules are revoked (disabled), never hard-deleted.
model FirewallJournal {
  id      String @id @default(cuid())
  router  Router @relation(fields: [routerId], references: [id], onDelete: Cascade)
  routerId String
  opId    String @unique // idempotency key of the journaled command
  action  String // e.g. firewall.rule.create
  table   String
  chain   String?
  ruleId  String? // platform rule id the op targeted (null for creates)
  before  Json    // before-snapshot of affected mirror rows (FirewallRule[])
  createdRuleIds Json @default("[]") // mirror rows created by the op (rollback revokes these)
  sentences Json   // exact sentences applied (string[][])
  status  String  @default("pending") // pending | applied | rolled-back
  createdAt DateTime @default(now())
  rolledBackAt DateTime?

  @@index([routerId])
}

// ---------------------------------------------------------------------------
// Queues
// ---------------------------------------------------------------------------

model Queue {
  id         String  @id @default(cuid())
  router     Router  @relation(fields: [routerId], references: [id], onDelete: Cascade)
  routerId   String
  kind       String // simple | tree
  name       String
  target     String? // simple: target address/interface
  parent     String? // tree: parent queue
  maxLimit   String? // "5M/10M"
  limitAt    String?
  priority   Int?
  disabled   Boolean @default(false)
  mikrotikId String?

  @@unique([routerId, kind, name])
}

// ---------------------------------------------------------------------------
// Backups
// ---------------------------------------------------------------------------

model Backup {
  id             String   @id @default(cuid())
  router         Router   @relation(fields: [routerId], references: [id], onDelete: Cascade)
  routerId       String
  type           String // export | binary
  fileName       String
  storageKey     String // object-storage key (encrypted blob)
  sizeBytes      BigInt
  sha256         String
  kmsKeyId       String
  retentionUntil DateTime
  createdAt      DateTime @default(now())

  @@index([routerId, createdAt])
}

/// Per-router backup schedule (consumed by the worker `backup` queue).
model BackupSchedule {
  id        String  @id @default(cuid())
  router    Router  @relation(fields: [routerId], references: [id], onDelete: Cascade)
  routerId  String
  type      String  @default("export") // export | binary | both
  cron      String  @default("0 2 * * *") // local-time cron, staggered by worker
  enabled   Boolean @default(true)
  retentionDays Int  @default(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([routerId, type])
  @@index([routerId])
}

// ---------------------------------------------------------------------------
// Downstream devices
// ---------------------------------------------------------------------------

model DownstreamDevice {
  id              String    @id @default(cuid())
  router          Router    @relation(fields: [routerId], references: [id], onDelete: Cascade)
  routerId        String
  deviceId        String // used in comment panel-proxy:<deviceId>
  name            String
  kind            String // mikrotik | ap | camera | pos | switch | other
  macAddress      String?
  lanIp           String
  mgmtPort        Int // 22 | 80 | 443 | 8728 | 8291
  protocol        String    @default("tcp")
  proxyPort       Int? // allocated tunnel-side port on the site router
  managedRouterId String? // if kind=mikrotik and registered → Router.id (cascade)
  lastSeen        DateTime?

  // --- vendor-neutral device identity (Phase 1: discovery + proxy only;
  //     Phase 2 lands per-vendor drivers behind the DeviceDriver contract) ---
  vendor          String    @default("unknown") // openwrt | ddwrt | ubiquiti | cisco | mikrotik | unknown
  model           String?   // e.g. "Archer C7", "hAP ac^2"
  mgmtMethods     Json?     // { web?: number, ssh?: number } — management ports on the device

  @@unique([routerId, deviceId])
  @@index([routerId])
}

// ---------------------------------------------------------------------------
// Provisioning
// ---------------------------------------------------------------------------

model OnboardingToken {
  id              String    @id @default(cuid())
  token           String    @unique // single-use; the router presents it
  issuedBy        User      @relation(fields: [issuedById], references: [id])
  issuedById      String
  siteId          String? // pre-assigned site
  sstpUsername    String    @unique
  sstpPasswordRef String // Vault/KMS reference — redeemed once via the .rsc endpoint
  apiPasswordRef  String // Vault/KMS reference for the on-router `panel-api` user
  tunnelIp        String    @unique
  expiresAt       DateTime // now + 15 min
  usedAt          DateTime?
  routerId        String? // set on successful callback

  @@index([expiresAt])
}

/// Walled-garden entries (allow/deny lists for hotspot). kind='dns' →
/// /ip/hotspot/walled-garden (dst-host); kind='ip' → .../walled-garden/ip.
model HotspotWalledGarden {
  id         String   @id @default(cuid())
  router     Router   @relation(fields: [routerId], references: [id], onDelete: Cascade)
  routerId   String
  kind       String   @default("dns")
  dstHost    String?
  dstAddress String?
  action     String   @default("allow") // allow | deny
  comment    String?
  disabled   Boolean  @default(false)
  mikrotikId String?
  createdAt  DateTime @default(now())

  @@index([routerId, kind])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

/// Alert routing rules: on bus event → enqueue `notify` job → channel sender.
/// Channel delivery (Telegram/email) requires config (TELEGRAM_BOT_TOKEN /
/// SMTP_*); without it the notify job fails with a clear NEEDS-CONFIG error —
/// sends are never faked.
model NotificationRule {
  id        String  @id @default(cuid())
  name      String
  event     String // router.offline | alert.raised | backup.completed | ...
  channel   String // telegram | email
  target    String // chat id / email address
  template  String? // optional message template override
  enabled   Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([event, enabled])
}

// ---------------------------------------------------------------------------
// Audit (append-only)
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actor     User?    @relation(fields: [actorId], references: [id])
  actorId   String?
  router    Router?  @relation(fields: [routerId], references: [id], onDelete: SetNull)
  routerId  String?
  action    String // hotspot.user.create | firewall.rule.move | backup.restore ...
  opId      String   @unique // idempotency key from the command path
  before    Json?
  after     Json?
  result    String // pending | done | failed
  error     String?
  createdAt DateTime @default(now())

  @@index([routerId, createdAt])
  @@index([actorId, createdAt])
}

// ---------------------------------------------------------------------------
// Secret vault (PostgresVault — see src/vault/postgres-vault.ts)
// ---------------------------------------------------------------------------

/// One encrypted secret. `ref` is the opaque `pg:<uuid>` reference stored in
/// business tables (e.g. Router.sstpPasswordRef); ciphertext/iv/authTag are
/// base64 AES-256-GCM parts. Plaintext and the master key are never stored.
model VaultEntry {
  ref        String   @id // pg:<uuid>
  ciphertext String // base64
  iv         String // base64, 12 bytes
  authTag    String // base64, 16 bytes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("vault_entries")
}
