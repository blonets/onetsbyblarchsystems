# apps/web environment — copy to `.env.local` for local development.
#
# Canonical public hosts (production):
#   Web UI + API ......... https://admin.onetsbyblarch.online
#   (Next.js serves the UI; the NestJS API lives on the same host.)
#   NOTE: vpn.onetsbyblarch.online (SSTP hub) is NOT referenced anywhere in
#   the web app — the hub address is router-side config (SSTP_HUB_HOST).

# --- API base URL ------------------------------------------------------------
# Production example (uncomment when building for deploy):
# NEXT_PUBLIC_API_URL=https://admin.onetsbyblarch.online
#
# The Socket.IO gateway is derived from this value as <base>/fleet.
# Leave it UNSET (or empty) for local dev: the dashboard runs against the
# clearly-marked mock adapter (fixture data, no backend needed).
#
# To point at a locally-running API instead:
# NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Mock override -----------------------------------------------------------
# Force the mock adapter even when NEXT_PUBLIC_API_URL is set (dev only):
# NEXT_PUBLIC_MOCK_API=true
